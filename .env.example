# Copy to .env (never commit .env) or set these in your host's dashboard.
# Every variable is optional for local development.

# Port the server listens on. Hosts like Railway, Render and Fly set this for you.
PORT=8787

# Set to "production" when deploying. Turns on secure __Host- cookies and HSTS,
# and serves the built frontend from ./dist.
NODE_ENV=development

# ── Storage ────────────────────────────────────────────────────────────
# Leave MONGODB_URI empty to use the built-in SQLite database in DATA_DIR.
# To use MongoDB Atlas, paste your connection string here:
#   MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=swimtrack

# Where SQLite and the generated secret key live. Must be on a persistent disk in production.
DATA_DIR=data

# ── Secrets ────────────────────────────────────────────────────────────
# 32 random bytes, base64. Encrypts 2FA secrets at rest. Generate with:
#   openssl rand -base64 32
# If unset, one is generated into DATA_DIR/secret.key on first run.
# Required in production when using MongoDB (the data folder may not persist).
SECRET_KEY=

# ── Networking ─────────────────────────────────────────────────────────
# Extra origins allowed to make write requests (same-origin is always allowed).
# The Android app (Capacitor) will need https://localhost here.
APP_ORIGINS=

# Set to 1 only behind a reverse proxy you control, so rate limits see real client IPs.
TRUST_PROXY=0

# ── Email ──────────────────────────────────────────────────────────────
# Public address of the app. Links in emails (confirm email, reset password) point here.
# Required in production; defaults to http://localhost:5173 in development.
APP_URL=

# Any SMTP provider. Without it, emails go to the dev outbox at /api/dev/outbox instead.
#   Gmail (needs 2-Step Verification and an app password from myaccount.google.com/apppasswords):
#     SMTP_URL=smtps://you%40gmail.com:your-app-password@smtp.gmail.com:465
#   Resend, Postmark, Mailgun, SES and others all give you an SMTP URL too.
SMTP_URL=
MAIL_FROM=SwimTrack <no-reply@yourdomain.ca>
# Where "Request a pilot" forms from the pricing section are emailed. Without it the form is off in production
# (in development it goes to the dev outbox).
CONTACT_EMAIL=

# ── Assistant ──────────────────────────────────────────────────────────
# The in-app "Ask" assistant. Any OpenAI-compatible chat API works; VoidAI is the default.
# Leave the key empty to turn the assistant off (the button disappears).
VOIDAI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_BASE_URL=https://api.voidai.app/v1
