{
  "name": "lanemark",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite --port 5173 --strictPort\" \"PORT=8787 node --env-file-if-exists=.env --watch-path=server server/index.ts\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "dev:web": "vite",
    "dev:api": "PORT=8787 node --env-file-if-exists=.env --watch-path=server server/index.ts",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.ts",
    "seed": "node --env-file-if-exists=.env server/seed.ts",
    "tunnel": "node scripts/tunnel.mjs",
    "mail:test": "node --env-file-if-exists=.env server/mailtest.ts",
    "guide:shots": "node scripts/guide-shots.mjs",
    "guide:md": "node scripts/guide-md.ts",
    "ship": "node scripts/ship.mjs",
    "app": "node scripts/app.mjs",
    "app:keystore": "node scripts/app.mjs keystore"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/share": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@hono/node-server": "^2.1.1",
    "cmdk": "^1.1.1",
    "hono": "^4.13.9",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.48.0",
    "mongodb": "^7.6.0",
    "motion": "^13.4.4",
    "nodemailer": "^10.0.10",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "vaul": "^1.1.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "mongodb-memory-server": "^11.3.0",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
